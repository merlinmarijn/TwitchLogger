# PostgreSQL 18 database supplied by compose.example.yaml.
DATABASE_URL=postgresql://twitch_logs:change_this_password@postgres:5432/twitch_logs

# One-time /admin setup key. Keep this server-side.
INGESTION_SECRET=replace_with_a_long_random_value

# Twitch confidential application settings.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=https://chatlogs.example.com/auth/twitch/callback
TWITCH_FRONTEND_URL=https://chatlogs.example.com
TWITCH_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
TWITCH_TOKEN_STORE_PATH=/data/twitch-tokens.enc

# Leave empty when the dashboard and worker use the same public origin.
PUBLIC_WORKER_URL=
WORKER_PORT=8787
LOG_LEVEL=info
COLD_ARCHIVE_CACHE_MAX_CHUNKS=32
COLD_ARCHIVE_CACHE_MAX_BYTES=67108864
# Set to verified database-host free bytes when PGDATA is not mounted in the worker container.
INDEX_REINDEX_FREE_BYTES=

# Public feedback form: one submission per IP during this window.
FEEDBACK_RATE_LIMIT_MINUTES=15
# Set to the exact trusted reverse-proxy hop count, or leave 0 for direct traffic.
TRUST_PROXY_HOPS=0
