# Existing external Convex deployment. The container never starts a Convex DB.
CONVEX_URL=https://your-existing-deployment.convex.cloud

# Must match INGESTION_SECRET configured on that Convex deployment.
INGESTION_SECRET=replace_with_a_long_random_value

# Twitch confidential application settings.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=https://chatlogs.example.com/auth/twitch/callback
TWITCH_FRONTEND_URL=https://chatlogs.example.com
TWITCH_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
TWITCH_TOKEN_STORE_PATH=/data/twitch-tokens.enc

# Leave empty when the dashboard and worker use the same public origin.
PUBLIC_WORKER_URL=
WORKER_PORT=8787
LOG_LEVEL=info
