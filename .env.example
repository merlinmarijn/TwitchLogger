# Browser-safe values (Vite exposes only VITE_* variables)
VITE_WORKER_URL=http://localhost:8787

# PostgreSQL 18 application database
DATABASE_URL=postgresql://twitch_logs:change_this_password@localhost:5432/twitch_logs
# Used only by compose.local-db.yaml (DATABASE_URL should then point to 127.0.0.1:5433).
LOCAL_POSTGRES_PASSWORD=change_this_local_password

# Twitch ingestion worker
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost:8787/auth/twitch/callback
TWITCH_FRONTEND_URL=http://localhost:5173
TWITCH_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
TWITCH_TOKEN_STORE_PATH=./data/twitch-tokens.enc
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
WORKER_PORT=8787
LOG_LEVEL=info
COLD_ARCHIVE_CACHE_MAX_CHUNKS=32
COLD_ARCHIVE_CACHE_MAX_BYTES=67108864
# Required by the admin concurrent-reindex job only if PGDATA is not visible to this process.
INDEX_REINDEX_FREE_BYTES=

# Public feedback form: one submission per IP during this window.
FEEDBACK_RATE_LIMIT_MINUTES=15
# Set to 1 only when requests always pass through one trusted reverse proxy.
TRUST_PROXY_HOPS=0

# One-time /admin setup key. Keep this server-side.
INGESTION_SECRET=replace_with_a_long_random_value
